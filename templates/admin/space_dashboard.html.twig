{% extends 'admin/space_base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block breadcrumb %}Dashboard{% endblock %}

{% block stylesheets %}
<style>
/* ── Enhanced metric cards ───────────────────────────────── */
.metric-card {
    position: relative;
    overflow: hidden;
    transition: transform .22s, box-shadow .22s;
    cursor: default;
}
.metric-card:hover { transform: translateY(-3px); }

.metric-card.mc-cyan:hover   { box-shadow: 0 0 36px rgba(0,245,255,.2),  0 10px 28px rgba(0,0,0,.35); }
.metric-card.mc-violet:hover { box-shadow: 0 0 36px rgba(123,47,255,.2), 0 10px 28px rgba(0,0,0,.35); }
.metric-card.mc-green:hover  { box-shadow: 0 0 36px rgba(0,255,179,.2),  0 10px 28px rgba(0,0,0,.35); }
.metric-card.mc-amber:hover  { box-shadow: 0 0 36px rgba(245,158,11,.2), 0 10px 28px rgba(0,0,0,.35); }

/* Background orb */
.metric-orb {
    position: absolute;
    width: 110px; height: 110px;
    border-radius: 50%;
    top: -28px; right: -28px;
    opacity: .07;
    pointer-events: none;
    transition: opacity .22s;
}
.metric-card:hover .metric-orb { opacity: .14; }
.mc-cyan   .metric-orb { background: radial-gradient(circle, var(--cyan),   transparent 70%); }
.mc-violet .metric-orb { background: radial-gradient(circle, var(--violet), transparent 70%); }
.mc-green  .metric-orb { background: radial-gradient(circle, var(--success),transparent 70%); }
.mc-amber  .metric-orb { background: radial-gradient(circle, #f59e0b,       transparent 70%); }

/* Top bar accent line */
.metric-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    border-radius: var(--radius) var(--radius) 0 0;
    opacity: 0;
    transition: opacity .22s;
}
.metric-card:hover::before { opacity: 1; }
.mc-cyan::before   { background: linear-gradient(90deg, var(--cyan),   transparent); }
.mc-violet::before { background: linear-gradient(90deg, var(--violet), transparent); }
.mc-green::before  { background: linear-gradient(90deg, var(--success),transparent); }
.mc-amber::before  { background: linear-gradient(90deg, #f59e0b,       transparent); }

.metric-icon {
    width: 46px; height: 46px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 21px;
    margin-bottom: 18px;
    flex-shrink: 0;
    transition: box-shadow .22s;
}
.ic-cyan   { background: rgba(0,245,255,.1);  border: 1px solid rgba(0,245,255,.2);  }
.ic-violet { background: rgba(123,47,255,.1); border: 1px solid rgba(123,47,255,.2); }
.ic-green  { background: rgba(0,255,179,.08); border: 1px solid rgba(0,255,179,.2);  }
.ic-amber  { background: rgba(245,158,11,.08);border: 1px solid rgba(245,158,11,.2); }

.mc-cyan:hover   .ic-cyan   { box-shadow: 0 0 18px rgba(0,245,255,.4);  }
.mc-violet:hover .ic-violet { box-shadow: 0 0 18px rgba(123,47,255,.4); }
.mc-green:hover  .ic-green  { box-shadow: 0 0 18px rgba(0,255,179,.4);  }
.mc-amber:hover  .ic-amber  { box-shadow: 0 0 18px rgba(245,158,11,.4); }

.metric-top   { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.metric-label { font-size: 11px; font-weight: 600; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom: 6px; }
.metric-value { font-size: 42px; font-weight: 700; line-height: 1; margin-bottom: 8px; }
.metric-sub   { font-size: 12px; color: var(--muted); }

.metric-trend {
    display: inline-flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 600;
    padding: 3px 9px; border-radius: 20px;
}
.trend-up      { background: rgba(0,255,179,.1);   color: var(--success); border:1px solid rgba(0,255,179,.2);   }
.trend-neutral { background: rgba(107,107,154,.1); color: var(--muted);   border:1px solid rgba(107,107,154,.2); }
.trend-amber   { background: rgba(245,158,11,.1);  color: #f59e0b;        border:1px solid rgba(245,158,11,.2);  }

.stat-cyan   { color: var(--cyan);    text-shadow: 0 0 22px rgba(0,245,255,.55);  }
.stat-violet { color: var(--violet);  text-shadow: 0 0 22px rgba(123,47,255,.55); }
.stat-green  { color: var(--success); text-shadow: 0 0 22px rgba(0,255,179,.45);  }
.stat-amber  { color: #f59e0b;        text-shadow: 0 0 22px rgba(245,158,11,.5);  }

/* Chart card */
.chart-title {
    font-size: 12px; font-weight: 600;
    letter-spacing:.07em; text-transform:uppercase; color:var(--muted);
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 8px;
}
.chart-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
}
.chart-dot-cyan   { background: var(--cyan);    box-shadow: 0 0 6px var(--cyan);    }
.chart-dot-violet { background: var(--violet);  box-shadow: 0 0 6px var(--violet);  }
.chart-dot-green  { background: var(--success); box-shadow: 0 0 6px var(--success); }
.chart-dot-amber  { background: #f59e0b;        box-shadow: 0 0 6px #f59e0b;        }

/* Top products table */
.top-rank {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 50%;
    font-size: 10px; font-weight: 700; flex-shrink: 0;
}
.rank-1 { background: rgba(245,158,11,.15); color: #f59e0b;  border: 1px solid rgba(245,158,11,.35); }
.rank-2 { background: rgba(180,180,200,.1); color: #b0b0cc;  border: 1px solid rgba(180,180,200,.25);}
.rank-3 { background: rgba(175,110,60,.15); color: #cd7f32;  border: 1px solid rgba(175,110,60,.3);  }
.rank-n { background: rgba(30,30,74,.5);    color: var(--muted); border: 1px solid var(--border);   }

/* Activity feed */
.activity-item {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 13px 0;
    border-bottom: 1px solid rgba(30,30,74,.7);
}
.activity-item:last-child { border-bottom: none; }
.activity-dot {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; flex-shrink: 0;
    border: 1px solid rgba(0,245,255,.2);
    background: rgba(0,245,255,.06);
}
.activity-dot.dot-pos { background: rgba(0,255,179,.07); border-color: rgba(0,255,179,.25); }
.activity-dot.dot-neg { background: rgba(255,77,109,.07);border-color: rgba(255,77,109,.25); }

.activity-body { flex: 1; min-width: 0; }
.activity-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.activity-meta { font-size: 11px; color: var(--muted); margin-top: 3px; }

/* Budget rows */
.budget-row {
    display: flex; align-items: center; gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(30,30,74,.7);
}
.budget-row:last-child { border-bottom: none; }
.budget-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: linear-gradient(135deg, rgba(123,47,255,.3), rgba(0,245,255,.25));
    border: 1px solid rgba(0,245,255,.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; color: var(--cyan);
    flex-shrink: 0;
}
.budget-info  { flex: 1; min-width: 0; }
.budget-name  { font-size: 13px; font-weight: 600; }
.budget-detail{ font-size: 11px; color: var(--muted); margin-top: 2px; }
.budget-amount{ font-size: 15px; font-weight: 700; color: var(--cyan); text-shadow: 0 0 10px rgba(0,245,255,.4); white-space: nowrap; }

/* Badge extras */
.badge-amber { background: rgba(245,158,11,.1); color:#f59e0b; border:1px solid rgba(245,158,11,.3); }
.badge-red   { background: rgba(255,77,109,.1); color:var(--danger); border:1px solid rgba(255,77,109,.3); }

@media (max-width: 1100px) {
    .dash-main { grid-template-columns: 1fr !important; }
}
</style>
{% endblock %}

{% block content %}

{# ── Header ───────────────────────────────────────────────── #}
<div class="page-header" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:28px;">
    <div>
        <div class="page-title">Dashboard</div>
        <div class="page-subtitle">Visión general del sistema · {{ "now"|date("d M Y, H:i") }}</div>
    </div>
    <div style="display:flex; gap:10px; align-items:center;">
        <span style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--success);padding:5px 12px;background:rgba(0,255,179,.06);border:1px solid rgba(0,255,179,.2);border-radius:20px;">
            <span style="width:6px;height:6px;border-radius:50%;background:var(--success);box-shadow:0 0 5px var(--success);animation:pulse 2s infinite;"></span>
            Sistema activo
        </span>
    </div>
</div>

<style>
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
</style>

{# ── 4 Metric cards ───────────────────────────────────────── #}
<div class="grid-4" style="margin-bottom:28px;">

    {# 1 · Productos activos #}
    <div class="card card-cyan metric-card mc-cyan">
        <div class="metric-orb"></div>
        <div class="metric-top">
            <div class="metric-icon ic-cyan">📦</div>
            <span class="metric-trend trend-up">
                <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
                +12%
            </span>
        </div>
        <div class="metric-label">Productos activos</div>
        <div class="metric-value stat-cyan">{{ total_modelos }}</div>
        <div class="metric-sub">{{ total_muebles }} en catálogo total</div>
    </div>

    {# 2 · Presupuestos totales #}
    <div class="card card-violet metric-card mc-violet">
        <div class="metric-orb"></div>
        <div class="metric-top">
            <div class="metric-icon ic-violet">📋</div>
            <span class="metric-trend trend-up">
                <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
                activo
            </span>
        </div>
        <div class="metric-label">Presupuestos totales</div>
        <div class="metric-value stat-violet">{{ total_presupuestos }}</div>
        <div class="metric-sub">{{ presupuestos_pendientes }} pendiente{{ presupuestos_pendientes != 1 ? 's' : '' }} de respuesta</div>
    </div>

    {# 3 · Reseñas / producto top #}
    <div class="card metric-card mc-green" style="border-color:rgba(0,255,179,.22);">
        <div class="metric-orb"></div>
        <div class="metric-top">
            <div class="metric-icon ic-green">⭐</div>
            <span class="metric-trend trend-up">
                <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 15l-6-6-6 6"/></svg>
                activo
            </span>
        </div>
        <div class="metric-label">Reseñas recibidas</div>
        <div class="metric-value stat-green">{{ total_reviews }}</div>
        <div class="metric-sub">
            {% if top_muebles|length > 0 %}
                Top: {{ top_muebles[0].name|slice(0,20) }}{% if top_muebles[0].name|length > 20 %}…{% endif %}
            {% else %}
                Sin reseñas aún
            {% endif %}
        </div>
    </div>

    {# 4 · Presupuestos pendientes #}
    <div class="card metric-card mc-amber" style="border-color:rgba(245,158,11,.22);">
        <div class="metric-orb"></div>
        <div class="metric-top">
            <div class="metric-icon ic-amber">📋</div>
            <span class="metric-trend trend-amber">Demo</span>
        </div>
        <div class="metric-label">Presupuestos pendientes</div>
        <div class="metric-value stat-amber">{{ presupuestos_pendientes }}</div>
        <div class="metric-sub">Requieren atención</div>
    </div>

</div>

{# ── Chart + Top products ─────────────────────────────────── #}
<div class="dash-main" style="display:grid; grid-template-columns:1fr 320px; gap:20px; margin-bottom:28px;">

    {# Chart.js — Pedidos por mes #}
    <div class="card" style="border-color:rgba(0,245,255,.18);">
        <div class="chart-title">
            <span class="chart-dot chart-dot-cyan"></span>
            Solicitudes de presupuesto por mes
            <span class="badge badge-amber" style="margin-left:auto; font-size:10px; padding:2px 8px;">datos demo</span>
        </div>
        <canvas id="ordersChart" style="width:100%; max-height:220px;"></canvas>
    </div>

    {# Top productos por reseñas #}
    <div class="card" style="border-color:rgba(123,47,255,.18);">
        <div class="chart-title">
            <span class="chart-dot chart-dot-violet"></span>
            Productos destacados
        </div>
        {% if top_muebles is empty %}
            <div style="text-align:center; color:var(--muted); padding:40px 0; font-size:13px;">
                Sin datos todavía
            </div>
        {% else %}
            <table class="space-table" style="font-size:12px;">
                <thead>
                    <tr>
                        <th style="width:36px; padding-left:8px;">#</th>
                        <th>Producto</th>
                        <th style="text-align:center; width:50px;">Res.</th>
                        <th style="width:48px;">Est.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for mueble in top_muebles %}
                    <tr>
                        <td style="padding-left:8px;">
                            <span class="top-rank {{ loop.index == 1 ? 'rank-1' : (loop.index == 2 ? 'rank-2' : (loop.index == 3 ? 'rank-3' : 'rank-n')) }}">
                                {{ loop.index }}
                            </span>
                        </td>
                        <td>
                            <div style="font-weight:600;">{{ mueble.name|slice(0,18) }}{% if mueble.name|length > 18 %}…{% endif %}</div>
                            <div style="font-size:10px; color:var(--muted);">{{ mueble.category.name }}</div>
                        </td>
                        <td style="text-align:center;">
                            <span class="badge badge-cyan" style="font-size:10px; padding:2px 7px;">{{ mueble.reviews|length }}</span>
                        </td>
                        <td>
                            {% if mueble.isActive %}
                                <span class="badge badge-green" style="font-size:10px; padding:2px 7px;">On</span>
                            {% else %}
                                <span class="badge badge-muted" style="font-size:10px; padding:2px 7px;">Off</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div style="margin-top:12px; text-align:right;">
                <a href="{{ path('app_admin_productos') }}" style="font-size:12px; color:var(--violet); text-decoration:none; opacity:.85;">
                    Ver todos →
                </a>
            </div>
        {% endif %}
    </div>
</div>

{# ── Presupuestos + Actividad reciente ────────────────────── #}
<div class="grid-2" style="margin-bottom:28px;">

    {# Presupuestos pendientes #}
    <div class="card" style="border-color:rgba(245,158,11,.18);">
        <div class="chart-title">
            <span class="chart-dot chart-dot-amber"></span>
            Presupuestos pendientes
            <span class="badge badge-amber" style="margin-left:auto; font-size:11px;">{{ presupuestos_pendientes }}</span>
        </div>

        {% if presupuestos_pendientes == 0 %}
        <div style="text-align:center; color:var(--muted); padding:32px 0; font-size:13px;">
            <div style="font-size:28px; margin-bottom:8px;">✅</div>
            Ninguna solicitud pendiente
        </div>
        {% else %}
        <div style="padding:14px 0; font-size:13px; color:var(--muted); line-height:1.7;">
            Hay <strong style="color:#f59e0b;">{{ presupuestos_pendientes }}</strong>
            solicitud{{ presupuestos_pendientes != 1 ? 'es' : '' }} esperando respuesta.
        </div>
        {% endif %}

        <div style="margin-top:12px;">
            <a href="{{ path('app_admin_presupuestos', {status: 'pending'}) }}"
               class="btn btn-cyan" style="font-size:12px; padding:7px 14px; width:100%; justify-content:center;">
                Ver solicitudes pendientes →
            </a>
        </div>
    </div>

    {# Actividad reciente (reseñas) #}
    <div class="card" style="border-color:rgba(0,255,179,.15);">
        <div class="chart-title">
            <span class="chart-dot chart-dot-green"></span>
            Actividad reciente
        </div>
        {% if recent_reviews is empty %}
            <div style="text-align:center; color:var(--muted); padding:40px 0; font-size:13px;">
                No hay reseñas recientes
            </div>
        {% else %}
            {% for review in recent_reviews %}
            {% set isPos = review.sentimentAi == 'positivo' %}
            {% set isNeg = review.sentimentAi == 'negativo' %}
            <div class="activity-item">
                <div class="activity-dot {{ isPos ? 'dot-pos' : (isNeg ? 'dot-neg' : '') }}">
                    {{ isPos ? '😊' : (isNeg ? '😞' : '💬') }}
                </div>
                <div class="activity-body">
                    <div class="activity-name">{{ review.mueble.name }}</div>
                    <div class="activity-meta" style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-top:4px;">
                        <span style="letter-spacing:.05em; color:{{ isPos ? '#f59e0b' : (isNeg ? 'var(--danger)' : 'var(--muted)') }}; font-size:12px;">
                            {% for i in 1..5 %}{{ i <= review.rating ? '★' : '☆' }}{% endfor %}
                        </span>
                        {% if review.sentimentAi %}
                            <span class="badge {{ isPos ? 'badge-green' : (isNeg ? 'badge-red' : 'badge-muted') }}" style="font-size:10px; padding:1px 7px;">
                                {{ review.sentimentAi }}
                            </span>
                        {% endif %}
                        <span class="badge {{ review.isApproved ? 'badge-cyan' : 'badge-muted' }}" style="font-size:10px; padding:1px 7px;">
                            {{ review.isApproved ? 'aprobada' : 'pendiente' }}
                        </span>
                    </div>
                    <div class="activity-meta" style="margin-top:5px; font-size:11px; font-style:italic; opacity:.75;">
                        "{{ review.comment|slice(0,65) }}{% if review.comment|length > 65 %}…{% endif %}"
                    </div>
                </div>
            </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{# ── Quick access ─────────────────────────────────────────── #}
<div class="neon-line"></div>
<div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
    <span style="font-size:12px; color:var(--muted); font-weight:500; margin-right:4px;">Acceso rápido:</span>
    <a href="{{ path('app_admin_productos') }}" class="btn btn-cyan" style="padding:7px 15px; font-size:12px;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M20 7H4a1 1 0 00-1 1v10a1 1 0 001 1h16a1 1 0 001-1V8a1 1 0 00-1-1z"/>
        </svg>
        Productos
    </a>
    <a href="{{ path('app_admin_presupuestos') }}" class="btn btn-cyan" style="padding:7px 15px; font-size:12px;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
        </svg>
        Presupuestos
    </a>
    <a href="{{ path('app_admin_modelos') }}" class="btn btn-cyan" style="padding:7px 15px; font-size:12px;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/>
        </svg>
        Imágenes 3D
    </a>
    <a href="{{ path('app_mueble_configurator') }}" target="_blank" class="btn btn-cyan" style="padding:7px 15px; font-size:12px;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/>
        </svg>
        Configurador 3D
    </a>
    <a href="{{ path('app_admin_dashboard') }}" target="_blank" class="btn btn-violet" style="padding:7px 15px; font-size:12px;">
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
        EasyAdmin
    </a>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
(function () {
    const labels = {{ chart_labels|raw }};
    const data   = {{ chart_orders|raw }};

    const ctx = document.getElementById('ordersChart').getContext('2d');

    const gradFill = ctx.createLinearGradient(0, 0, 0, 230);
    gradFill.addColorStop(0,    'rgba(0,245,255,.30)');
    gradFill.addColorStop(0.55, 'rgba(0,245,255,.07)');
    gradFill.addColorStop(1,    'rgba(0,245,255,0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Pedidos',
                data,
                fill: true,
                backgroundColor: gradFill,
                borderColor: '#00f5ff',
                borderWidth: 2,
                pointBackgroundColor: '#00f5ff',
                pointBorderColor: '#0a0a1a',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 7,
                pointHoverBackgroundColor: '#fff',
                pointHoverBorderColor: '#00f5ff',
                tension: 0.42,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { intersect: false, mode: 'index' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#10103a',
                    borderColor: 'rgba(0,245,255,.35)',
                    borderWidth: 1,
                    titleColor: '#00f5ff',
                    bodyColor: '#dde1ff',
                    padding: 14,
                    cornerRadius: 8,
                    displayColors: false,
                    callbacks: {
                        title: items => items[0].label,
                        label: ctx  => ` ${ctx.parsed.y} pedidos`,
                    }
                }
            },
            scales: {
                x: {
                    grid: { color: 'rgba(30,30,74,.9)', tickLength: 0 },
                    ticks: {
                        color: '#6b6b9a',
