<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Panel de Control{% endblock %} · Nuevas Tendencias Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* ── Variables ───────────────────────────────────────── */
        :root {
            --bg:         #0a0a1a;
            --sidebar-bg: #0c0c26;
            --topbar-bg:  #0b0b22;
            --card-bg:    #10103a;
            --border:     #1e1e4a;
            --cyan:       #00f5ff;
            --violet:     #7b2fff;
            --text:       #dde1ff;
            --muted:      #6b6b9a;
            --danger:     #ff4d6d;
            --success:    #00ffb3;
            --sidebar-w:  260px;
            --topbar-h:   64px;
            --radius:     12px;
        }

        /* ── Reset / Base ────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 15px;
        }

        /* ── Starfield (CSS only) ────────────────────────────── */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                radial-gradient(1px 1px at  8%  12%, rgba(255,255,255,.55), transparent),
                radial-gradient(1px 1px at 22%  68%, rgba(0,245,255,.35), transparent),
                radial-gradient(1px 1px at 38%  30%, rgba(255,255,255,.4), transparent),
                radial-gradient(1px 1px at 55%  85%, rgba(123,47,255,.4), transparent),
                radial-gradient(1px 1px at 70%  15%, rgba(255,255,255,.5), transparent),
                radial-gradient(1px 1px at 83%  55%, rgba(0,245,255,.3), transparent),
                radial-gradient(1px 1px at 92%  78%, rgba(255,255,255,.45), transparent),
                radial-gradient(1px 1px at 14%  44%, rgba(123,47,255,.3), transparent),
                radial-gradient(1px 1px at 47%  52%, rgba(255,255,255,.3), transparent),
                radial-gradient(1px 1px at 62%  35%, rgba(0,245,255,.25), transparent),
                radial-gradient(2px 2px at 30%  90%, rgba(0,245,255,.2), transparent),
                radial-gradient(2px 2px at 75%  42%, rgba(123,47,255,.2), transparent),
                radial-gradient(1px 1px at  5%  80%, rgba(255,255,255,.35), transparent),
                radial-gradient(1px 1px at 88%  25%, rgba(255,255,255,.3), transparent);
            pointer-events: none;
            z-index: 0;
        }

        /* ── Layout grid ─────────────────────────────────────── */
        .admin-layout {
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: var(--topbar-h) 1fr;
            min-height: 100vh;
            position: relative;
            z-index: 1;
        }

        /* ── Topbar ──────────────────────────────────────────── */
        .topbar {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px 0 0;
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            width: var(--sidebar-w);
            padding: 0 24px;
            gap: 12px;
        }

        .topbar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .topbar-logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--cyan), var(--violet));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 0 16px rgba(0,245,255,.4);
        }

        .topbar-logo-text {
            font-size: 16px;
            font-weight: 700;
            letter-spacing: .05em;
            background: linear-gradient(90deg, var(--cyan), var(--violet));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .topbar-breadcrumb {
            flex: 1;
            padding: 0 24px;
            font-size: 13px;
            color: var(--muted);
        }

        .topbar-breadcrumb strong {
            color: var(--text);
            font-weight: 500;
        }

        .topbar-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            background: rgba(0,245,255,.06);
            border: 1px solid rgba(0,245,255,.2);
            border-radius: 20px;
            font-size: 13px;
            color: var(--cyan);
            font-weight: 500;
        }

        .topbar-chip svg { opacity: .8; }

        .topbar-logout {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 16px;
            background: rgba(255,77,109,.08);
            border: 1px solid rgba(255,77,109,.3);
            border-radius: 8px;
            color: #ff4d6d;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: all .2s;
        }
        .topbar-logout:hover {
            background: rgba(255,77,109,.18);
            box-shadow: 0 0 12px rgba(255,77,109,.25);
        }

        /* ── Sidebar ─────────────────────────────────────────── */
        .sidebar {
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            padding: 24px 0;
            position: sticky;
            top: var(--topbar-h);
            height: calc(100vh - var(--topbar-h));
            overflow-y: auto;
        }

        .sidebar-section-label {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 20px 20px 8px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 20px;
            margin: 2px 10px;
            border-radius: var(--radius);
            text-decoration: none;
            color: var(--muted);
            font-size: 14px;
            font-weight: 500;
            transition: all .18s;
            position: relative;
        }

        .sidebar-item:hover {
            background: rgba(0,245,255,.07);
            color: var(--text);
        }

        .sidebar-item.active {
            background: linear-gradient(90deg, rgba(0,245,255,.12), rgba(123,47,255,.08));
            color: var(--cyan);
            border: 1px solid rgba(0,245,255,.2);
        }

        .sidebar-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 3px;
            background: var(--cyan);
            border-radius: 0 4px 4px 0;
            box-shadow: 0 0 8px var(--cyan);
        }

        .sidebar-item svg {
            flex-shrink: 0;
            opacity: .7;
        }

        .sidebar-item.active svg { opacity: 1; }

        .sidebar-badge {
            margin-left: auto;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 10px;
            background: rgba(0,245,255,.15);
            color: var(--cyan);
        }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 16px 20px;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 20px;
            border-top: 1px solid var(--border);
            font-size: 12px;
            color: var(--muted);
            line-height: 1.6;
        }

        .sidebar-footer strong { color: var(--violet); }

        /* ── Content area ────────────────────────────────────── */
        .admin-content {
            padding: 32px;
            overflow-y: auto;
            background: transparent;
        }

        /* ── Utility components ──────────────────────────────── */
        .page-header {
            margin-bottom: 32px;
        }

        .page-title {
            font-size: 26px;
            font-weight: 700;
            background: linear-gradient(90deg, var(--text), var(--muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--muted);
            margin-top: 4px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
        }

        .card-cyan {
            border-color: rgba(0,245,255,.25);
            box-shadow: 0 0 20px rgba(0,245,255,.06), inset 0 1px 0 rgba(0,245,255,.1);
        }

        .card-violet {
            border-color: rgba(123,47,255,.25);
            box-shadow: 0 0 20px rgba(123,47,255,.06), inset 0 1px 0 rgba(123,47,255,.1);
        }

        .stat-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .stat-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .stat-value {
            font-size: 36px;
            font-weight: 700;
            line-height: 1;
        }

        .stat-cyan  { color: var(--cyan);    text-shadow: 0 0 20px rgba(0,245,255,.5);  }
        .stat-violet { color: var(--violet); text-shadow: 0 0 20px rgba(123,47,255,.5); }
        .stat-green  { color: var(--success); text-shadow: 0 0 20px rgba(0,255,179,.4); }
        .stat-red    { color: var(--danger);  text-shadow: 0 0 20px rgba(255,77,109,.4);}

        .stat-meta {
            font-size: 12px;
            color: var(--muted);
        }

        /* Grid helpers */
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

        /* Table */
        .space-table { width: 100%; border-collapse: collapse; }
        .space-table th {
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
        }
        .space-table td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(30,30,74,.6);
            font-size: 14px;
        }
        .space-table tr:last-child td { border-bottom: none; }
        .space-table tr:hover td { background: rgba(0,245,255,.03); }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-cyan   { background: rgba(0,245,255,.12);  color: var(--cyan);    border: 1px solid rgba(0,245,255,.25);  }
        .badge-violet { background: rgba(123,47,255,.12); color: var(--violet); border: 1px solid rgba(123,47,255,.25); }
        .badge-green  { background: rgba(0,255,179,.1);   color: var(--success); border: 1px solid rgba(0,255,179,.25); }
        .badge-muted  { background: rgba(107,107,154,.12);color: var(--muted);  border: 1px solid rgba(107,107,154,.25);}

        /* Btn */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all .18s;
            font-family: inherit;
        }
        .btn-cyan {
            background: rgba(0,245,255,.12);
            color: var(--cyan);
            border: 1px solid rgba(0,245,255,.35);
        }
        .btn-cyan:hover {
            background: rgba(0,245,255,.22);
            box-shadow: 0 0 16px rgba(0,245,255,.3);
        }
        .btn-violet {
            background: linear-gradient(135deg, var(--violet), #5a1fc8);
            color: #fff;
            box-shadow: 0 4px 14px rgba(123,47,255,.35);
        }
        .btn-violet:hover { box-shadow: 0 4px 22px rgba(123,47,255,.55); }

        /* Neon separator */
        .neon-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), transparent);
            margin: 28px 0;
            opacity: .4;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--violet); }

        /* Responsive */
        @media (max-width: 900px) {
            .grid-4 { grid-template-columns: repeat(2,1fr); }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>

<body>
<div class="admin-layout">

    {# ── TOPBAR ──────────────────────────────────────────────── #}
    <header class="topbar">
        <div class="topbar-left">
            <a href="{{ path('app_admin_dashboard') }}" class="topbar-logo">
                <div class="topbar-logo-icon">🛸</div>
                <span class="topbar-logo-text">SPACE ADMIN</span>
            </a>
        </div>

        <div class="topbar-breadcrumb">
            <span>Panel</span>
            {% if block('breadcrumb') is defined %}
                &nbsp;/&nbsp;<strong>{% block breadcrumb %}{% endblock %}</strong>
            {% endif %}
        </div>

        <div class="topbar-right">
            <div class="topbar-chip">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                </svg>
                admin
            </div>
            <a href="{{ path('app_admin_logout') }}" class="topbar-logout">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"/>
                </svg>
                Salir
            </a>
        </div>
    </header>

    {# ── SIDEBAR ─────────────────────────────────────────────── #}
    {% set route = app.request.attributes.get('_route') %}
    <aside class="sidebar">

        <span class="sidebar-section-label">Navegación</span>

        <a href="{{ path('app_admin_dashboard') }}"
           class="sidebar-item {{ route == 'app_admin_dashboard' ? 'active' : '' }}">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Dashboard
        </a>

        <div class="sidebar-divider"></div>
        <span class="sidebar-section-label">Catálogo</span>

        <a href="{{ path('app_admin_productos') }}"
           class="sidebar-item {{ route == 'app_admin_productos' ? 'active' : '' }}">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M20 7H4a1 1 0 00-1 1v10a1 1 0 001 1h16a1 1 0 001-1V8a1 1 0 00-1-1z"/>
                <path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
                <line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/>
            </svg>
            Productos
        </a>

        <a href="{{ path('app_admin_presupuestos') }}"
           class="sidebar-item {{ route starts with 'app_admin_presupuesto' ? 'active' : '' }}">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
            </svg>
            Presupuestos
            {% if admin_pending_orders > 0 %}
            <span class="sidebar-badge">{{ admin_pending_orders }}</span>
            {% endif %}
        </a>

        <div class="sidebar-divider"></div>
        <span class="sidebar-section-label">Contenido 3D</span>

        <a href="{{ path('app_admin_modelos') }}"
           class="sidebar-item {{ route == 'app_admin_modelos' ? 'active' : '' }}">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
            </svg>
            Imágenes / 3D
        </a>

        <a href="{{ path('app_mueble_configurator') }}" target="_blank"
           class="sidebar-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h4m12 0h4M12 2v4m0 12v4"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
            Configurador 3D
            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:auto; opacity:.5">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
        </a>

        <div class="sidebar-divider"></div>
        <span class="sidebar-section-label">Sistema</span>

        <a href="{{ path('app_admin_dashboard') }}" target="_blank"
           class="sidebar-item">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            EasyAdmin (CRUD)
            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="margin-left:auto; opacity:.5">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
        </a>

        <div class="sidebar-footer">
            <strong>Nuevas Tendencias</strong> Admin v1.0<br>
            Symfony 8 · PHP 8.4 · TFG 2026
        </div>
    </aside>

    {# ── CONTENT ─────────────────────────────────────────────── #}
    <main class="admin-content">
        {% block content %}{% endblock %}
    </main>

</div>
{{ importmap('admin') }}
{% block javascripts %}{% endblock %}
</body>
</html>
