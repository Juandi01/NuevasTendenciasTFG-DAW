<turbo-stream action="remove" target="{{ target }}"></turbo-stream>
<turbo-stream action="prepend" target="flash-zone">
    <template>
        <div class="flash-toast flash-success" id="flash-{{ target }}" style="animation:fadeInSlide .3s ease;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M20 6L9 17l-5-5"/>
            </svg>
            Producto "{{ name }}" eliminado
        </div>
        <script>setTimeout(()=>document.getElementById('flash-{{ target }}')?.remove(), 3500)</script>
    </template>
</turbo-stream>
