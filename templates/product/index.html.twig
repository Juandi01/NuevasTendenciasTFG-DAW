{% extends 'base.html.twig' %}

{% block title %}Productos — Nuevas Tendencias{% endblock %}

{% block stylesheets %}
<style>
    /* Indicador visual mientras el frame carga */
    turbo-frame[busy] {
        opacity: 0.4;
        pointer-events: none;
        transition: opacity 0.15s ease;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-12">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-10">
        <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl">
            Nuestros <span class="text-indigo-600">Productos</span>
        </h1>
        <p class="mt-4 text-xl text-gray-500">Encuentra el mueble perfecto para tu espacio.</p>
    </div>

    {#
        data-turbo-frame apunta al frame de abajo.
        Turbo intercepta el submit, hace el fetch y reemplaza
        solo el contenido de <turbo-frame id="product-grid">.
    #}
    <form method="GET" action="{{ path('app_product_index') }}"
          data-turbo-frame="product-grid"
          class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-10">

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Buscar</label>
                <input type="text" name="search" value="{{ filters.search ?? '' }}"
                       placeholder="Nombre o descripción…"
                       class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Categoría</label>
                <select name="category"
                        class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                    <option value="">Todas</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ (filters.category ?? '') == cat.id ? 'selected' : '' }}>
                            {{ cat.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex gap-2">
                <div class="flex-1">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Precio mín.</label>
                    <input type="number" name="min_price" min="0" step="0.01"
                           value="{{ filters.min_price ?? '' }}" placeholder="0 €"
                           class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                </div>
                <div class="flex-1">
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Precio máx.</label>
                    <input type="number" name="max_price" min="0" step="0.01"
                           value="{{ filters.max_price ?? '' }}" placeholder="9999 €"
                           class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                </div>
            </div>

            <div class="grid grid-cols-3 gap-2">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Ancho cm</label>
                    <input type="number" name="max_width" min="0" step="1"
                           value="{{ filters.max_width ?? '' }}" placeholder="máx"
                           class="w-full border border-gray-200 rounded-xl px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Alto cm</label>
                    <input type="number" name="max_height" min="0" step="1"
                           value="{{ filters.max_height ?? '' }}" placeholder="máx"
                           class="w-full border border-gray-200 rounded-xl px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Fondo cm</label>
                    <input type="number" name="max_depth" min="0" step="1"
                           value="{{ filters.max_depth ?? '' }}" placeholder="máx"
                           class="w-full border border-gray-200 rounded-xl px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400">
                </div>
            </div>

        </div>

        <div class="flex items-center gap-3 mt-5">
            {# data-turbo-submits-with cambia el texto del botón mientras carga #}
            <button type="submit"
                    data-turbo-submits-with="Buscando…"
                    class="bg-indigo-600 text-white font-bold px-6 py-2 rounded-xl hover:bg-indigo-700 transition-colors text-sm">
                Filtrar
            </button>
            {# El enlace también apunta al frame para no recargar la página #}
            <a href="{{ path('app_product_index') }}"
               data-turbo-frame="product-grid"
               class="text-sm text-gray-500 hover:text-gray-700 font-medium">
                Limpiar filtros
            </a>
        </div>
    </form>

    {# Solo esta sección se reemplaza al filtrar #}
    {% include 'product/_grid.html.twig' %}

</div>
</div>
{% endblock %}
